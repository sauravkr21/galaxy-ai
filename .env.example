# ─────────────────────────────────────────────────────────────
# NextFlow environment. Copy to `.env` and fill in real values.
# ─────────────────────────────────────────────────────────────

# ── Database (Neon PostgreSQL) ──
# Pooled connection string used at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Direct (non-pooled) connection used by `prisma migrate` / `db push`.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# ── Clerk (auth) ──
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxx"
CLERK_SECRET_KEY="sk_test_xxx"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/dashboard"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/dashboard"

# ── Google Gemini (Google AI Studio) ──
GEMINI_API_KEY="AIza_xxx"
# Default model used by every Gemini node unless overridden in the node header.
GEMINI_DEFAULT_MODEL="gemini-3.1-pro"

# ── Trigger.dev ──
TRIGGER_PROJECT_REF="proj_xxx"
TRIGGER_SECRET_KEY="tr_dev_xxx"
# Public, used by the realtime hook in the browser.
NEXT_PUBLIC_TRIGGER_API_URL="https://api.trigger.dev"

# ── Transloadit (image/file uploads) ──
NEXT_PUBLIC_TRANSLOADIT_KEY="transloadit_auth_key"
TRANSLOADIT_SECRET="transloadit_secret"
# A Template that runs /image/resize (or pass-through store) and exposes the result.
TRANSLOADIT_TEMPLATE_ID="template_id"

# ── App ──
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Printed once by every Trigger.dev task AND on the initial client render of
# every page: "[NextFlow] Candidate LinkedIn: <url>". NEXT_PUBLIC_ so the
# browser bundle can read it for the client-render log.
NEXT_PUBLIC_CANDIDATE_LINKEDIN_URL="https://www.linkedin.com/in/your-full-linkedin-profile-url"
CANDIDATE_LINKEDIN_URL="https://www.linkedin.com/in/your-full-linkedin-profile-url"

# Set to "1" to run executions in-process (no Trigger.dev) for local demos.
# Leave unset/0 in production so all executions go through Trigger.dev tasks.
LOCAL_EXECUTOR="0"
